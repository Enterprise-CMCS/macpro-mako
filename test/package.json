{
  "name": "e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "e2e": "playwright test --project=mocked",
    "e2e:ui": "playwright test --ui --project=mocked",
    "e2e:deployed": "playwright test --project=deployed-create --project=deployed-read --project=deployed-mutate",
    "e2e:deployed:ui": "playwright test --ui --project=deployed-create --project=deployed-read --project=deployed-mutate",
    "e2e:quarantine": "playwright test --project=mocked --test-list=quarantine.txt --repeat-each=5 --retries=0",
    "e2e:merge-reports": "playwright merge-reports --reporter=html,json ./all-blob-reports",
    "e2e:flaky-report": "bun scripts/flaky-report.ts"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@msw/playwright": "^0.6.7",
    "@playwright/test": "^1.65.1",
    "eslint-plugin-playwright": "^2.12.2",
    "msw": "^2.12.10"
  }
}
